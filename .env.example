# EmailJS Configuration
# Sign up at https://www.emailjs.com/
# 1. Create an Email Service (e.g., Gmail) -> get Service ID
# 2. Create an Email Template -> get Template ID
# 3. Go to Account Settings -> get Public Key
VITE_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# WhatsApp Configuration
# Phone number with country code (no '+' or spaces), e.g. 919542784868
VITE_APP_WHATSAPP_NUMBER=919542784868
